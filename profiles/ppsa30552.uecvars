# Unreal feature switcher profile for PPSA30552 (UE 5.6): turn off or down what KosmicKrisp/Apple
# cannot do or cannot afford. Names and values only (no game data). Applied by cmd/uecvar emit ->
# NPS5_OVERLAY_DIR (docs/m3/uecvar.md). Entries land in Engine.ini [SystemSettings], which wins
# over the project's DefaultEngine.ini (SetBySystemSettingsIni > SetByProjectSetting).
# Names are checked against the binary with `uecvar check`; unknown ones are reported, not fatal.

# --- Nanite: needs 64-bit buffer atomics (software raster) and mesh shaders (hardware raster);
#     KosmicKrisp has neither. r.Nanite=0 draws the fallback meshes (see docs: stripped fallbacks).
r.Nanite=0
r.Nanite.MeshShaderRasterization=0
r.Nanite.PrimShaderRasterization=0
r.Nanite.ComputeRasterization=0
r.Nanite.Streaming.AsyncCompute=0
r.Nanite.AllowSkinnedMeshes=0
r.Nanite.Tessellation=0

# --- Ray tracing: not exposed by KosmicKrisp.
r.RayTracing=0
r.RayTracing.Shadows=0
r.RayTracing.AmbientOcclusion=0
r.RayTracing.Translucency=0
r.Lumen.HardwareRayTracing=0
r.Lumen.Reflections.HardwareRayTracing=0

# --- Lumen GI / reflections (0 = none for GI, 2 = SSR for reflections) and what it feeds on.
r.DynamicGlobalIlluminationMethod=0
r.ReflectionMethod=2
r.Lumen.DiffuseIndirect.Allow=0
r.Lumen.Reflections.Allow=0
r.Lumen.TraceMeshSDFs=0
r.GenerateMeshDistanceFields=0
r.DistanceFields=0
r.DistanceFieldAO=0
r.AOGlobalDistanceField=0

# --- Shadows: no virtual shadow maps; plain cascaded maps, small and few.
r.Shadow.Virtual.Enable=0
r.ShadowQuality=2
r.Shadow.MaxResolution=1024
r.Shadow.CSM.MaxCascades=2
r.ContactShadows=0
r.CapsuleShadows=0

# --- Post-processing: motion blur, DOF, bloom, AO, SSR off; TSR/TAA -> FXAA.
r.MotionBlurQuality=0
r.DepthOfFieldQuality=0
r.BloomQuality=0
r.LensFlareQuality=0
r.LightShaftQuality=0
r.AmbientOcclusionLevels=0
r.DefaultFeature.MotionBlur=0
r.DefaultFeature.Bloom=0
r.DefaultFeature.AmbientOcclusion=0
r.DefaultFeature.LensFlare=0
r.SSR.Quality=0
r.AntiAliasingMethod=1
r.TemporalAA.Upsampling=0
r.FXAA.Quality=2
r.EyeAdaptationQuality=0
r.Tonemapper.Sharpen=0

# --- Resolution: the guest renders 3840x2160; render at 50% and let the spatial upscaler fill the rest.
r.ScreenPercentage=50

# --- Heavy volumetrics / hair.
r.VolumetricFog=0
r.VolumetricCloud=0
r.HairStrands.Enable=0

# --- Async compute: KosmicKrisp exposes one queue, ACB work is serialised; avoid cross-queue waits.
r.RDG.AsyncCompute=0
r.Lumen.AsyncCompute=0
r.Bloom.AsyncCompute=0
r.TSR.AsyncCompute=0
r.SceneDepthHZBAsyncCompute=0
r.DFShadowAsyncCompute=0
r.SkyAtmosphereASyncCompute=0
r.VolumetricRenderTarget.PreferAsyncCompute=0
r.EnableAsyncComputeTranslucencyLightingVolumeClear=0

# --- Variable-rate shading: not exposed.
r.VRS.Enable=0
